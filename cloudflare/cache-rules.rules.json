{
  "description": "Cache Rules for andreysidorov.com (GitHub Pages origin). Applied via cloudflare/apply-cache-rules.sh. Last matching rule wins.",
  "rules": [
    {
      "expression": "starts_with(http.request.uri.path, \"/assets/\")",
      "description": "Immutable — /assets",
      "action": "set_cache_settings",
      "action_parameters": {
        "cache": true,
        "edge_ttl": {
          "mode": "override_origin",
          "default": 31536000
        },
        "browser_ttl": {
          "mode": "override_origin",
          "default": 31536000
        }
      },
      "enabled": true
    },
    {
      "expression": "starts_with(http.request.uri.path, \"/tags/\") and http.request.uri.path contains \"/assets/\"",
      "description": "Immutable — /tags/*/assets",
      "action": "set_cache_settings",
      "action_parameters": {
        "cache": true,
        "edge_ttl": {
          "mode": "override_origin",
          "default": 31536000
        },
        "browser_ttl": {
          "mode": "override_origin",
          "default": 31536000
        }
      },
      "enabled": true
    },
    {
      "expression": "starts_with(http.request.uri.path, \"/fonts/\") or http.request.uri.path eq \"/site.webmanifest\" or http.request.uri.path.extension in {\"woff2\" \"ico\" \"png\" \"svg\"}",
      "description": "Static binaries — fonts, favicons, manifest",
      "action": "set_cache_settings",
      "action_parameters": {
        "cache": true,
        "edge_ttl": {
          "mode": "override_origin",
          "default": 31536000
        },
        "browser_ttl": {
          "mode": "override_origin",
          "default": 31536000
        }
      },
      "enabled": true
    },
    {
      "expression": "http.request.uri.path.extension eq \"html\" or http.request.uri.path eq \"/\" or http.request.uri.path eq \"/rss.xml\" or http.request.uri.path eq \"/sitemap.xml\" or http.request.uri.path eq \"/robots.txt\" or http.request.uri.path eq \"/404.html\"",
      "description": "HTML and feeds — bypass edge cache",
      "action": "set_cache_settings",
      "action_parameters": {
        "cache": false
      },
      "enabled": true
    },
    {
      "expression": "true",
      "description": "Default — respect origin (GitHub Pages)",
      "action": "set_cache_settings",
      "action_parameters": {
        "cache": true,
        "edge_ttl": {
          "mode": "respect_origin"
        },
        "browser_ttl": {
          "mode": "respect_origin"
        }
      },
      "enabled": true
    }
  ]
}
